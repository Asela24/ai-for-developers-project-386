amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

// Fast checks on staged files (pre-commit).
local fast = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = List("**/*.{ts,tsx,js,json,jsonc,css,yml,yaml,md}")
    check = "pnpm exec oxfmt --check --no-error-on-unmatched-pattern {{ files }}"
    fix = "pnpm exec oxfmt --no-error-on-unmatched-pattern {{ files }}"
  }
  ["oxlint"] {
    glob = List("**/*.{ts,tsx,js}")
    check = "pnpm exec oxlint --deny-warnings {{ files }}"
  }
  ["jactionlint"] {
    glob = List(".github/workflows/*.{yml,yaml}")
    // Generated by Hexlet; must not be edited, so its findings can't be fixed here.
    exclude = List(".github/workflows/hexlet-check.yml")
    check = "jactionlint {{ files }}"
  }
}

// Whole-project checks (pre-push, `mise run check`, CI).
local all = new Mapping<String, Step> {
  ...fast
  ["typecheck"] { check = "pnpm typecheck" }
  ["knip"] { check = "pnpm knip" }
  ["syncpack"] { check = "pnpm deps:check" }
  ["test"] { check = "pnpm test" } // smoke tests
  // Build, then make sure generated files were committed up to date.
  ["build"] {
    depends = List("typecheck") // both run `tsc -b`; avoid racing on build info
    check = "pnpm build && git diff --exit-code -- apps/web/src/routeTree.gen.ts"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] { check = "pnpm --silent commitlint --edit {{ commit_msg_file }}" }
    }
  }
  ["pre-push"] { steps = all }
  ["check"] { steps = all }
  ["fix"] {
    fix = true
    steps = all
  }
}
