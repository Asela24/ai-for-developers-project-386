{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // TypeSpec is compiled by the `tsp` CLI (`pnpm contract`), not imported from TypeScript.
      "ignoreDependencies": ["@typespec/http", "@typespec/openapi", "@typespec/openapi3"],
    },
    "apps/web": {
      // Route files are loaded by the TanStack Router plugin, not imported directly.
      "entry": ["src/routes/**/*.tsx", "e2e/**/*.ts"],
      // shadcn/ui: the CLI imports `@/lib/utils` from components it adds (components.json → aliases.utils).
      // src/client is generated by @hey-api/openapi-ts. The page imports the index only.
      "ignore": ["src/lib/utils.ts", "src/client/**"],
    },
    "apps/server": {
      // Generated by openapi-typescript from openapi/openapi.yaml.
      "ignore": ["src/openapi.gen.ts"],
      // Invoked by `pnpm contract`, not imported.
      "ignoreDependencies": ["openapi-typescript"],
    },
  },
  "ignoreIssues": {
    // shadcn/ui components export variants helpers by convention.
    "apps/web/src/components/ui/**": ["exports"],
  },
}
